# Fork CI only: retain the app's forced-header semantics while allowing ccache
# to hash each translation unit normally instead of using a binary PCH.
get_property(_snow_fork_try_compile GLOBAL PROPERTY IN_TRY_COMPILE)
if(_snow_fork_try_compile)
    return()
endif()
include_guard(GLOBAL)

function(snow_fork_cached_prefix)
    if(NOT TARGET snow_shot)
        message(FATAL_ERROR "snow_shot target is missing")
    endif()
    get_target_property(_headers snow_shot PRECOMPILE_HEADERS)
    get_target_property(_sources snow_shot SOURCES)
    if(NOT _headers OR NOT _sources)
        message(FATAL_ERROR "snow_shot PCH inputs or sources are missing")
    endif()
    set(_content "#pragma once\n")
    foreach(_header IN LISTS _headers)
        if(NOT _header MATCHES "^<[^>]+>$")
            message(FATAL_ERROR "Unsupported PCH header; update fork cache policy: ${_header}")
        endif()
        string(APPEND _content "#include ${_header}\n")
    endforeach()
    set(_prefix "${CMAKE_BINARY_DIR}/snow-fork-cached-prefix.hxx")
    if(EXISTS "${_prefix}")
        file(READ "${_prefix}" _existing)
    endif()
    if(NOT "${_existing}" STREQUAL "${_content}")
        file(WRITE "${_prefix}" "${_content}")
    endif()
    set_target_properties(snow_shot PROPERTIES DISABLE_PRECOMPILE_HEADERS ON)
    list(REMOVE_DUPLICATES _sources)
    foreach(_source IN LISTS _sources)
        if(_source MATCHES "^\\$<")
            if(_source MATCHES "\\.(cpp|cxx|cc|mm)")
                message(FATAL_ERROR "Unsupported generated source expression: ${_source}")
            endif()
            continue()
        endif()
        if(NOT _source MATCHES "\\.(cpp|cxx|cc|mm)$")
            continue()
        endif()
        get_source_file_property(_skip "${_source}" TARGET_DIRECTORY snow_shot SKIP_PRECOMPILE_HEADERS)
        if(NOT _skip)
            # Source properties are directory scoped; restrict the options to
            # this target when a source is also compiled into another target.
            set_property(SOURCE "${_source}" TARGET_DIRECTORY snow_shot APPEND PROPERTY
                COMPILE_OPTIONS
                "$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,snow_shot>:-include>"
                "$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,snow_shot>:${_prefix}>")
        endif()
    endforeach()
endfunction()

cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL snow_fork_cached_prefix)
